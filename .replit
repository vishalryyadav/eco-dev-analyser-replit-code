run = "pnpm run dev"
modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[env]
ECODEV_EXEC_TIMEOUT_MS = "5000"
ECODEV_EXEC_MEMORY_MB = "256"
ECODEV_EXEC_PIDS = "32"
ECODEV_CPU_WATTS_LOW = "15"
ECODEV_CPU_WATTS_HIGH = "45"
ECODEV_CARBON_G_PER_KWH_LOW = "100"
ECODEV_CARBON_G_PER_KWH_HIGH = "800"
# Optional SCI-style regional-factor override. Omit to retain eco.ts's 710 fallback.
# ECODEV_GRID_FACTOR_G_PER_KWH = "710"
ECODEV_RATE_WINDOW_MS = "60000"
ECODEV_RATE_LIMIT = "30"
