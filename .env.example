# EcoDev API runtime limits
PORT=5000
# Comma-separated explicit browser origins. Do not use * for a public code-execution API.
ECODEV_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 only behind a reverse proxy you operate and trust.
ECODEV_TRUST_PROXY=0
ECODEV_RATE_LIMIT=30
ECODEV_RATE_WINDOW_MS=60000
ECODEV_EXEC_TIMEOUT_MS=5000
ECODEV_EXEC_MEMORY_MB=256
ECODEV_EXEC_PIDS=32
# Maximum individual file produced by a compiler/program. Set ECODEV_WORK_ROOT
# to a sized tmpfs path in public deployments to bound total temporary storage.
ECODEV_EXEC_FILE_SIZE_KB=1024
# Runs are rejected with sandbox_busy when this local process is at capacity.
ECODEV_EXEC_CONCURRENCY=1

# Scenario model defaults. Replace with measured device power and
# location/time-specific grid intensity when available.
ECODEV_CPU_WATTS_LOW=15
ECODEV_CPU_WATTS_HIGH=45
ECODEV_CARBON_G_PER_KWH_LOW=100
ECODEV_CARBON_G_PER_KWH_HIGH=800
# Illustrative impact-scenario workload only; this is not an observed user frequency.
ECODEV_RUNS_PER_DAY=100
# Optional regional-factor override for the SCI-style estimate. Leave unset to
# retain the implementation's India FY2024–25 reference fallback.
# ECODEV_GRID_FACTOR_G_PER_KWH=710

# Optional AI coach. Keep the API key server-side; leave unset to use the local rules coach.
OPENAI_API_KEY=
ECODEV_AI_MODEL=gpt-5.6-luna

# Desktop agent
ECODEV_AGENT_PORT=17777
ECODEV_AGENT_INTERVAL_MS=5000
