# EcoDev API runtime limits
PORT=5000
ECODEV_CORS_ORIGIN=http://localhost:5000
ECODEV_RATE_LIMIT=30
ECODEV_RATE_WINDOW_MS=60000
ECODEV_EXEC_TIMEOUT_MS=5000
ECODEV_EXEC_MEMORY_MB=256
ECODEV_EXEC_PIDS=32

# Scenario model defaults. Replace with measured device power and
# location/time-specific grid intensity when available.
ECODEV_CPU_WATTS_LOW=15
ECODEV_CPU_WATTS_HIGH=45
ECODEV_CARBON_G_PER_KWH_LOW=100
ECODEV_CARBON_G_PER_KWH_HIGH=800# EcoDev API
ECODEV_CORS_ORIGIN=
ECODEV_RATE_WINDOW_MS=60000
ECODEV_RATE_LIMIT=30
ECODEV_EXEC_TIMEOUT_MS=5000
ECODEV_EXEC_MEMORY_MB=256
ECODEV_EXEC_PIDS=32

# Sustainability model defaults. These are assumptions, not direct measurements.
ECODEV_CPU_WATTS=25
ECODEV_CARBON_G_PER_KWH=400

# Optional AI coach. Keep the API key server-side; leave unset to use the local rules coach.
OPENAI_API_KEY=
ECODEV_AI_MODEL=gpt-5.6-luna

# Desktop agent
ECODEV_AGENT_PORT=17777
ECODEV_AGENT_INTERVAL_MS=5000
