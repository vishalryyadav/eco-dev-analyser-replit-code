{
  "name": "ecodev-green-code",
  "displayName": "EcoDev Green Code Analyzer",
  "description": "Analyze code in VS Code for complexity, performance, memory, security, and green-computing trade-offs.",
  "version": "0.2.0",
  "publisher": "ecodev",
  "license": "MIT",
  "engines": { "vscode": ">=1.90.0" },
  "categories": ["Linters", "Other", "Programming Languages"],
  "activationEvents": ["onStartupFinished", "onCommand:ecodev.analyzeFile", "onCommand:ecodev.analyzeSelection", "onCommand:ecodev.analyzeWorkspace"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "ecodev.analyzeFile", "title": "EcoDev: Analyze Current File" },
      { "command": "ecodev.analyzeSelection", "title": "EcoDev: Analyze Selection" },
      { "command": "ecodev.analyzeWorkspace", "title": "EcoDev: Analyze Workspace" },
      { "command": "ecodev.openSettings", "title": "EcoDev: Open Settings" }
    ],
    "configuration": {
      "title": "EcoDev",
      "properties": {
        "ecodev.endpoint": { "type": "string", "default": "http://localhost:5000/api/analyze", "description": "EcoDev API endpoint." },
        "ecodev.analyzeOnSave": { "type": "boolean", "default": false, "description": "Analyze supported files after save." },
        "ecodev.executeCode": { "type": "boolean", "default": false, "description": "Ask the API to compile/run code when a secure sandbox is available." },
        "ecodev.profile": { "type": "string", "enum": ["balanced", "fast", "memory", "green", "reliable", "secure", "scalable"], "default": "balanced", "description": "Optimization preference used by the API recommendation layer." }
      }
    }
  },
  "scripts": { "compile": "tsc -p tsconfig.json", "package": "npm run compile" },
  "devDependencies": { "@types/node": "^22.0.0", "@types/vscode": "^1.90.0", "typescript": "^5.9.3" }
}
